{
  "expo": {
    "name": "Plannex",
    "slug": "plannex",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#090d16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.plannex.app"
    },
    "android": {
      "package": "com.plannex.app",
      "adaptiveIcon": {
        "backgroundColor": "#090d16"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Plannex necesita acceso a tus fotos para adjuntar comprobantes de pago.",
          "cameraPermission": "Plannex necesita acceso a la cámara para fotografiar comprobantes bancarios."
        }
      ]
    ]
  }
}
