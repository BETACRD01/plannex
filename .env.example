# ========================================================
# CONFIGURACIÓN COMPARTIDA DE SUPABASE
# ========================================================
# Obtén estas claves en tu panel de Supabase:
# https://supabase.com/dashboard -> Tu Proyecto -> Project Settings -> API

# Configuración para Web (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Configuración para Móvil (Expo)
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Clave de servicio (OPCIONAL: solo para tareas administrativas en backend, NUNCA exponer en cliente)
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta
